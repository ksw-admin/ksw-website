---
// Shown after the contact form was sent (Netlify redirects the POST here). Not for search engines.
import Base from '../../../layouts/Base.astro';
---

<Base title="Nachricht gesendet" noindex>
  <section class="band">
    <div class="wrap">
      <h1 class="cond">Danke für die Nachricht.</h1>
      <p>Sie ist angekommen. Peter Griepentrog meldet sich per E-Mail oder Telefon.</p>
      <a class="btn" href="/">Zur Startseite</a>
    </div>
  </section>
</Base>

<style>
  section { padding-block: 56px 80px; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 0.95; font-weight: 900; }
  p { margin-top: 16px; max-width: 52ch; font-size: 1.1rem; }
  .btn { margin-top: 24px; }
</style>
