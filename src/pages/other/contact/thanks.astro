---
// Shown after the contact form was sent (Netlify redirects the POST here). Not for search engines.
import Base from '../../../layouts/Base.astro';
---

<Base title="Nachricht gesendet" noindex>
  <section class="band">
    <div class="wrap">
      <h1 class="page-title">Danke für die Nachricht.</h1>
      <p>Sie ist angekommen. Peter Griepentrog meldet sich per E-Mail oder Telefon.</p>
      <a class="btn" href="/">Zur Startseite</a>
    </div>
  </section>
</Base>

<style>
  section { padding-block: var(--space-page-top) var(--space-section); }
  p { margin-top: 16px; max-width: 52ch; font-size: var(--fs-lead); }
  .btn { margin-top: 24px; }
</style>
