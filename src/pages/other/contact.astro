---
import Base from '../../layouts/Base.astro';
import Visit from '../../components/Visit.astro';
---

<Base title="Kontakt" description="Telefon, E-Mail und Adresse der Trainingshalle in Duisburg-Rheinhausen">
  <Visit lang="de" heading="Kontakt und Probetraining" />
</Base>

<style is:global>
  /* The black contact band fills the window down to the footer (no grey gap on tall screens). */
  body > main:has(> .visit:only-child) { display: flex; flex-direction: column; }
  body > main > .visit:only-child { flex: 1 0 auto; }
</style>
