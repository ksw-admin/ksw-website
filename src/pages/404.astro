---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" noindex>
  <section class="band">
    <div class="wrap">
      <div class="sec-h"><h1>Diese Seite gibt es nicht.</h1></div>
      <p>Vielleicht wurde sie verschoben. <a href="/">Zur Startseite</a> oder zu den <a href="/#woche">Trainingszeiten</a>.</p>
    </div>
  </section>
</Base>

<style>
  section { padding-block: 56px 96px; }
  p { margin-top: 20px; font-size: 1.2rem; }
</style>
