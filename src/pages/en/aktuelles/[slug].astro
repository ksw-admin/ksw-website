---
// /en/aktuelles/<name>/ for every visible news post (see the German route): long posts render their page
// (English text when translated), short posts forward to their entry in the English list.
import PostPage from '../../../components/PostPage.astro';
import { getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getPosts('en')).filter((p) => p.collection === 'news');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
if (!post.hasPage) return Astro.redirect(`/en/articles/#${encodeURIComponent(post.slug)}`);
---

<PostPage post={post} />
