---
/** Shown after the question form was sent (Netlify redirects the POST here). Not for search engines. */
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base title={t('faq.thanks.title')} noindex alternate={{ de: '/faq/thanks/', en: '/en/faq/thanks/' }}>
  <section class="band">
    <div class="wrap">
      <h1 class="page-title">{t('faq.thanks.title')}</h1>
      <p>{t('faq.thanks.text')}</p>
      <a class="btn" href={localePath('/faq/', lang)}>{t('faq.thanks.back')}</a>
    </div>
  </section>
</Base>

<style>
  section { padding-block: var(--space-page-top) var(--space-section); }
  p { margin-top: 16px; max-width: 52ch; font-size: var(--fs-lead); }
  .btn { margin-top: 24px; }
</style>
