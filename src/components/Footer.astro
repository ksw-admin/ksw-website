---
/**
 * Footer: bookend to the header (yellow line, logo), three short link groups, then a quiet bottom line.
 * Impressum and Datenschutz stay German only (legally binding text).
 */
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { site, primaryPhone, phoneLabel, telHref } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const groups = [
  {
    title: t('footer.training'),
    links: [
      { href: localePath('/category/kuksoolwon/', lang), label: t('nav.ksw') },
      { href: localePath('/category/taichi/', lang), label: t('nav.taichi') },
      { href: localePath('/#schedule', lang), label: t('footer.times') },
      ...(site.calendarPage ? [{ href: localePath('/dates/', lang), label: lang === 'de' ? 'Kalender' : 'Calendar' }] : []),
      { href: localePath('/articles/', lang), label: t('nav.news') },
      { href: localePath('/faq/', lang), label: t('faq.title') },
    ],
  },
  {
    title: t('footer.contact'),
    links: [
      { href: telHref(primaryPhone.value), label: phoneLabel(primaryPhone.value) },
      { href: `mailto:${site.email}`, label: site.email },
      { href: localePath('/other/contact/', lang), label: t('footer.directions') },
    ],
  },
  {
    title: t('footer.more'),
    links: [
      { href: '/other/imprint/', label: t('footer.impressum'), hreflang: 'de' },
      { href: '/other/privacy/', label: t('footer.privacy'), hreflang: 'de' },
      { href: '/other/sponsors/', label: t('footer.sponsors') },
      ...site.social.map((s) => ({ href: s.url, label: s.name, rel: 'me noopener' })),
    ],
  },
];
---

<footer class="band">
  <div class="wrap top">
    <a class="brand" href={localePath('/', lang)}>
      <span class="logo-wrap" aria-hidden="true"><span class="logo"></span></span>
      <span>Kampfkunst Academy<small>Peter Griepentrog</small></span>
    </a>
    {
      groups.map((g) => (
        <nav aria-label={g.title}>
          <h2>{g.title}</h2>
          <ul>
            {g.links.map((l) => (
              <li>
                <a href={l.href} hreflang={'hreflang' in l ? l.hreflang : undefined} rel={'rel' in l ? l.rel : undefined}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap bottom">
    <span>© {year} {site.name}</span>
    <div class="theme" role="group" aria-label={t('theme.label')}>
      <span class="theme-label">{t('theme.label')}:</span>
      <button type="button" data-theme-choice="system" aria-pressed="true">{t('theme.system')}</button>
      <button type="button" data-theme-choice="light" aria-pressed="false">{t('theme.light')}</button>
      <button type="button" data-theme-choice="dark" aria-pressed="false">{t('theme.dark')}</button>
    </div>
    {site.credit.url ? <a class="credit" href={site.credit.url} rel="noopener">{site.credit.text}</a> : <span>{site.credit.text}</span>}
  </div>
</footer>

<script>
  // Hell / Dunkel override the system setting via <html data-theme> (global.css has both blocks); Automatisch removes it.
  const root = document.documentElement;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
  const show = () => {
    const current = root.dataset.theme ?? 'system';
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current));
  };
  for (const b of buttons) {
    b.addEventListener('click', () => {
      const choice = b.dataset.themeChoice!;
      if (choice === 'system') delete root.dataset.theme;
      else root.dataset.theme = choice;
      try {
        if (choice === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', choice);
      } catch {}
      show();
    });
  }
  show();
</script>

<style>
  .logo { flex: none; width: 36px; height: 48px; background: var(--gelb); -webkit-mask: url('/images/Logo.svg') center / contain no-repeat; mask: url('/images/Logo.svg') center / contain no-repeat; }
  footer { background: var(--panel); color: var(--stein); border-top: 1px solid var(--linie); padding-block: 48px 92px; font-size: 0.95rem; }
  @media (min-width: 701px) { footer { padding-block: 48px 24px; } }
  .top { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr)); gap: 32px; align-items: start; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--panel-fg); text-decoration: none; font-weight: 800; line-height: 1.1; font-size: 1.1rem; }
  .brand img { width: 36px; height: 48px; }
  .brand small { display: block; font-weight: 500; font-size: var(--fs-meta); color: var(--stein); }
  h2 { font-size: 0.95rem; font-weight: 700; color: var(--panel-fg); margin-bottom: 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  a { color: var(--stein); text-decoration: none; overflow-wrap: anywhere; }
  ul a:hover, ul a:focus-visible { color: var(--panel-fg); text-decoration: underline; text-underline-offset: 3px; }
  .bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 12px 24px; flex-wrap: wrap; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--linie); font-size: var(--fs-meta); color: var(--stein); }
  /* Same pattern as the language switch in the header: current choice bold with a yellow underline. */
  .credit { color: inherit; }
  .credit:hover, .credit:focus-visible { color: var(--panel-fg); text-decoration: underline; text-underline-offset: 3px; }
  .theme { display: flex; align-items: baseline; gap: 12px; }
  .theme button { background: none; border: 0; padding: 0; font: inherit; color: var(--stein); cursor: pointer; }
  .theme button:hover { color: var(--panel-fg); text-decoration: underline; text-underline-offset: 3px; }
  .theme button[aria-pressed='true'] { color: var(--panel-fg); font-weight: 700; text-decoration: underline; text-decoration-color: var(--gelb); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  @media (max-width: 860px) {
    .top { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .brand { grid-column: 1 / -1; }
  }
  @media (max-width: 420px) { .top { grid-template-columns: 1fr; } }
</style>
