---
import { site, primaryPhone, telHref } from '../lib/site';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; heading: string; intro?: string; /** 1 on the contact page, where this is the page heading */ level?: 1 | 2 }
const { lang, heading, intro, level = 2 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
const de = lang === 'de';
const others = site.phones.filter((p) => p !== primaryPhone);
---

<section class="visit band" id="besuch">
  <div class="wrap">
    <div>
      <H class="cond">{heading}</H>
      {intro && <p class="intro">{intro}</p>}
      <a class="phone cond num" href={telHref(primaryPhone.value)}>
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="24" height="24" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        </span>
        <span class="visually-hidden">{de ? 'Anrufen: ' : 'Call: '}</span>{primaryPhone.value.replace(/ - /g, ' ')}
      </a>
      <p class="who">
        {site.contactName}. <a href={`mailto:${site.email}`}>{site.email}</a>
        {others.map((p) => <><br />{p.label} {p.value}</>)}
      </p>
      <p class="faq-hint">
        {de
          ? <>Antworten zu Probetraining, Alter, Prüfungen{site.calendar ? ' und Kalender-Abo' : ''} findest du bei den <a href={localePath('/faq/', lang)}>häufigen Fragen</a>.</>
          : <>You'll find answers about trial lessons, age, gradings{site.calendar ? ' and the calendar subscription' : ''} in the <a href={localePath('/faq/', lang)}>FAQ</a>.</>}
      </p>
    </div>
    <div class="side">
      <address><b>{de ? 'Trainingshalle' : 'Training hall'}</b>{site.hall.street}<br />{site.hall.note && <>{site.hall.note}<br /></>}{site.hall.city}</address>
      <a href={site.hall.osm} rel="noopener">{de ? 'Route in OpenStreetMap öffnen' : 'Directions on OpenStreetMap'}</a>
      {site.social.length > 0 && (
        <p class="social">{site.social.map((s) => <a href={s.url} rel="me noopener">{s.label ?? s.name}</a>)}</p>
      )}
      <slot />
    </div>
  </div>
</section>

<style>
  .visit { background: #000; color: #fff; padding-block: 64px; }
  .wrap { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px; }
  :is(h1, h2) { font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 0.9; font-weight: 900; }
  .phone {
    display: inline-flex; align-items: center; gap: 0.25em; margin-top: 26px;
    font-size: clamp(2.4rem, 7vw, 5.2rem); font-weight: 900; line-height: 1; text-decoration: none; letter-spacing: -0.01em; color: var(--gelb);
  }
  .phone:hover { text-decoration: underline; text-decoration-thickness: 0.06em; text-underline-offset: 0.12em; }
  /* Yellow round button with a black handset: shows the number can be tapped. */
  .icon { flex: none; display: grid; place-items: center; width: 0.82em; height: 0.82em; border-radius: 50%; background: var(--gelb); color: #000; transition: transform 0.2s ease; }
  .icon svg { width: 52%; height: 52%; }
  .phone:hover .icon { transform: rotate(-12deg); }
  .who { margin-top: 8px; font-weight: 600; }
  .faq-hint { margin-top: 20px; color: #cfd2cb; max-width: 48ch; }
  .faq-hint a { color: #fff; font-weight: 700; text-underline-offset: 4px; }
  .intro { margin-top: 14px; font-size: 1.15rem; max-width: 44ch; }
  address { font-style: normal; font-size: 1.15rem; line-height: 1.5; }
  address b { display: block; font-size: 0.95rem; margin-bottom: 4px; }
  .side { display: grid; gap: 24px; align-content: start; border-left: 1px solid rgb(255 255 255 / 0.28); padding-left: 24px; }
  .side a { font-weight: 700; }
  .social { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  @media (max-width: 760px) {
    .wrap { grid-template-columns: 1fr; }
    .side { border-left: 0; padding-left: 0; border-top: 1px solid rgb(255 255 255 / 0.28); padding-top: 20px; }
  }
</style>
