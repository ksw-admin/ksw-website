---
/**
 * Two full-bleed halves, two voices of one typeface: condensed/heavy for Kuk Sool Won, wide/light for Tai Chi.
 * Texts come from home.json (CMS: Startseite); every number and time comes from schedule.json (Trainingszeiten).
 */
import { localePath, type Lang } from '../i18n/ui';
import { getSchedule, dayList, type Weekday } from '../lib/schedule';
import { paragraphsOf } from '../lib/home';

interface Props { lang: Lang; kswText: string; taichiText: string }
const { lang, kswText, taichiText } = Astro.props;
const de = lang === 'de';

const ksw = await getSchedule('kuksoolwon');
const taichi = await getSchedule('taichi');
// One plain sentence per discipline, built from the training times (no trivia numbers).
const youngest = Math.min(...ksw.map((s) => s.ageMin ?? Infinity));
const adults = ksw.find((s) => s.ageMax === undefined)?.ageMin;
const kswDays = dayList([...new Set(ksw.flatMap((s) => s.days))] as Weekday[], lang);
const kswKids = ksw.filter((s) => s.ageMax !== undefined).length;
const kswFact = de
  ? `${kswDays}. Kinder ab ${youngest} Jahren in ${kswKids} Altersgruppen${adults ? `, Erwachsene ab ${adults}` : ''}.`
  : `${kswDays}. Children from ${youngest} in ${kswKids} age groups${adults ? `, adults from ${adults}` : ''}.`;
const taichiTimes = taichi.map((s) => `${dayList(s.days, lang)} ${s.from}`).join(de ? ' und ' : ' and ');
const taichiFact = de ? `${taichiTimes} Uhr. In jedem Alter, ohne Leistungsdruck.` : `${taichiTimes}. Any age, not competitive.`;
---

<section class="paths">
  <div class="path k" id="ksw">
    <div class="inner">
      <div class="hangul" lang="ko" aria-hidden="true">국술원</div>
      <h2 class="cond">Kuk Sool Won</h2>
      <div class="body">{paragraphsOf(kswText).map((p) => <p>{p}</p>)}</div>
      <p class="fact">{kswFact}</p>
      <a class="more" href={localePath('/category/kuksoolwon/', lang)}>{de ? 'Mehr über Kuk Sool Won' : 'More about Kuk Sool Won'}</a>
    </div>
  </div>
  <div class="path t" id="taichi">
    <div class="inner">
      <h2 class="wide">{de ? 'Tai Chi, Qi Gong und Atemschulung' : 'Tai Chi, Qi Gong and breathing training'}</h2>
      <div class="body">{paragraphsOf(taichiText).map((p) => <p>{p}</p>)}</div>
      <p class="fact">{taichiFact}</p>
      <a class="more" href={localePath('/category/taichi/', lang)}>{de ? 'Mehr über Tai Chi und Atemschulung' : 'More about Tai Chi and breathing training'}</a>
    </div>
  </div>
</section>

<style>
  .paths { display: grid; grid-template-columns: 1fr 1fr; }
  .path { padding-block: 64px 72px; }
  .inner { max-width: calc(var(--max) / 2); padding-inline: var(--gutter-l) 40px; }
  .k { background: var(--panel); color: var(--panel-fg); }
  .k .inner { margin-left: auto; }
  .t { background: var(--tc-bg); color: var(--tc-fg); }
  .t .inner { padding-inline: 40px var(--gutter-r); }
  .hangul { font-family: var(--hangul); font-weight: 800; color: var(--gelb); font-size: clamp(3rem, 7vw, 5.5rem); line-height: 1; letter-spacing: 0.06em; }
  .k h2 { font-size: clamp(2.6rem, 5.5vw, 4.4rem); line-height: 0.9; margin-top: 14px; font-weight: 900; }
  .t h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); line-height: 1.08; font-weight: 300; margin-top: 6px; }
  .body { margin-top: 22px; max-width: 42ch; }
  .t .body { line-height: 1.75; }
  .body p + p { margin-top: 12px; }
  /* Training days and ages in each discipline's own voice (condensed vs wide). */
  .fact { margin-top: 26px; max-width: 34ch; font-size: 1.25rem; line-height: 1.3; }
  .k .fact { font-weight: 800; font-stretch: 62%; font-size: 1.45rem; }
  .t .fact { font-weight: 400; font-stretch: 125%; }
  .more { display: inline-block; margin-top: 32px; font-weight: 700; text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .k .more { color: var(--gelb); }
  @media (max-width: 860px) {
    .paths { grid-template-columns: 1fr; }
    .inner, .t .inner { max-width: none; margin: 0; padding-inline: var(--gutter-l) var(--gutter-r); }
  }
</style>
