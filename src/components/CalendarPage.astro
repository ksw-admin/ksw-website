---
/**
 * Calendar page (/dates/, /en/dates/; CMS switch site.json › calendarPage): training, closures and dates of the next
 * weeks as an agenda, grouped by week. Not a month grid: training repeats every week, the useful part is what
 * differs (no training, tournaments, cancellations). Same data and rules as the calendar feeds (src/lib/agenda.ts).
 * All groups: one line per discipline and day ("16:00–21:30 Kuk Sool Won, alle 5 Gruppen"), so the weeks stay short
 * and what differs stands out; a discipline whose groups are only partly cancelled that day shows its groups singly.
 * Filter by group (also ?group=<slot id>, linked from the timetable): that group's own lines and the closures
 * that affect it; dates stay (they are in every feed). The subscribe links (only here; under the timetable only when
 * this page is off) follow the filter. Wide screens: filter and subscribe links in a column that stays in view.
 * Static page: the script hides days that have passed since the last build and marks today. Without JS: everything
 * from the build day on, unfiltered.
 * Not under /calendar/: Netlify serves that folder as text/calendar (public/_headers).
 */
import Base from '../layouts/Base.astro';
import { getSchedule, toFeed, ageLabel, dayShort, type Slot } from '../lib/schedule';
import { getClosures } from '../lib/closures-data';
import { getEvents } from '../lib/events-data';
import { buildAgenda, byWeek, mondayOf, weekLabel } from '../lib/agenda';
import { addDays, headline, textOf, todayInGermany, type Closure } from '../lib/closures';
import { kindOf, titleOf, whenOf } from '../lib/events';
import { site } from '../lib/site';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
const t = useTranslations(lang);

/** How far ahead the page lays out days; dates and closures after that are listed under "Später". */
const WEEKS = 13;
const today = todayInGermany();
const thisYear = Number(today.slice(0, 4));
const start = mondayOf(today);
const end = addDays(start, WEEKS * 7 - 1);

const slots = await getSchedule();
const bySlot = new Map(slots.map((s) => [s.id, s]));
const closures = await getClosures();
const events = await getEvents();
const weeks = byWeek(buildAgenda({ slots: slots.map(toFeed), closures, events, from: start, days: WEEKS * 7 }));
const later = {
  events: events.filter((e) => e.from > end),
  closures: closures.filter((c) => c.from > end),
};

const groupName = (s: Slot) =>
  s.discipline === 'taichi' ? (de ? 'Tai Chi und Qi Gong' : 'Tai Chi and Qi Gong') : ['Kuk Sool Won', ageLabel(s, lang)].filter(Boolean).join(', ');
const option = (s: Slot) => `${groupName(s)} (${s.days.map((d) => dayShort(d, lang)).join(', ')})`;
const dayLabel = (d: string) => whenOf({ from: d, title: '' }, lang, thisYear);
const closureGroups = (c: Closure) => c.groups ?? 'alle';

type Day = (typeof weeks)[number]['days'][number];
const DISCIPLINES = ['kuksoolwon', 'taichi'] as const;
const totalOf = (disc: string) => slots.filter((s) => s.discipline === disc).length;
/** All-groups view: one line per discipline, unless only some of its groups are cancelled that day (then: singly). */
function summaries(d: Day) {
  return DISCIPLINES.flatMap((disc) => {
    const ts = d.training.filter((t) => t.slot.discipline === disc);
    if (!ts.length) return [];
    const off = ts.filter((t) => t.off).length;
    if (off && off < ts.length) return [{ disc, mixed: true as const }];
    const from = ts.map((t) => t.slot.from).sort()[0];
    const to = ts.map((t) => t.slot.to).sort().at(-1)!;
    const n = ts.length;
    const base = disc === 'taichi' ? (de ? 'Tai Chi und Qi Gong' : 'Tai Chi and Qi Gong') : 'Kuk Sool Won';
    const label =
      n === 1 ? groupName(bySlot.get(ts[0].slot.id)!)
      : n === totalOf(disc) ? `${base}, ${de ? `alle ${n} Gruppen` : `all ${n} groups`}`
      : `${base}, ${n} ${de ? 'Gruppen' : 'groups'}`;
    return [{ disc, mixed: false as const, from, to, label, off: off === n }];
  });
}
const mixedOf = (d: Day) => new Set(summaries(d).filter((s) => s.mixed).map((s) => s.disc));

const webcal = (id: string) => `webcal://${Astro.site!.host}/calendar/${id}.ics`;
const google = (id: string) => `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(webcal(id))}`;
const title = de ? 'Kalender' : 'Calendar';
---

<Base
  title={title}
  description={de ? 'Trainingszeiten, Trainingsausfälle, Turniere und Prüfungen der nächsten Wochen, nach Gruppe.' : 'Training times, closures, tournaments and gradings for the coming weeks, by group.'}
  alternate={{ de: '/dates/', en: '/en/dates/' }}
>
  <section class="band cal-page">
    <div class="wrap">
      <h1 class="page-title">{title}</h1>
      <p class="lead">{de ? 'Training, Ausfälle und Termine der nächsten drei Monate.' : 'Training, closures and dates for the next three months.'}</p>

      <div class="layout">
      <aside class="tools" aria-label={de ? 'Gruppe und Abo' : 'Group and subscription'}>
        <div class="pick">
          <label for="cal-group">{de ? 'Gruppe' : 'Group'}</label>
          <select id="cal-group" aria-controls="agenda">
            <option value="">{de ? 'Alle Gruppen' : 'All groups'}</option>
            {slots.map((s) => <option value={s.id} data-disc={s.discipline}>{option(s)}</option>)}
          </select>
        </div>
        {site.calendar && (
          <div class="subscribe" id="cal-sub" data-label-all={t('week.calendar')} data-label-one={t('week.calendar.one')}>
            <h2>{de ? 'Abonnieren' : 'Subscribe'}</h2>
            <p class="sub-label">{t('week.calendar')}</p>
            <p class="sub-links">
              <a data-cal href={google('training')} rel="noopener">{de ? 'Google Kalender' : 'Google Calendar'}</a>
              <a data-cal href={webcal('training')}>iPhone, Mac, Outlook</a>
            </p>
            <a class="howto" href={localePath('/faq/#kalender', lang)}>{de ? 'So funktioniert das Abo' : 'How subscribing works'}</a>
          </div>
        )}
      </aside>

      <div id="agenda" aria-live="polite">
        {weeks.map((w) => (
          <section class="week" data-week={w.monday} aria-labelledby={`w-${w.monday}`}>
            <h2 id={`w-${w.monday}`}>{weekLabel(w.monday, lang, thisYear)}</h2>
            <ol class="days">
              {w.days.map((d) => (
                <li class="day" data-date={d.date}>
                  <p class="date num">
                    {dayLabel(d.date)}
                    <span class="today" hidden>{de ? 'Heute' : 'Today'}</span>
                  </p>
                  <ul class="items">
                    {d.events.map((e) => (
                      <li class:list={['event', { cancelled: e.cancelled }]}>
                        <p class="meta">
                          {e.cancelled && <strong>{de ? 'Abgesagt' : 'Cancelled'}</strong>}
                          {e.cancelled && (e.kind || e.place) && ', '}
                          {[kindOf(e, lang), e.place].filter(Boolean).join(', ')}
                        </p>
                        <p class="ev-title" lang={lang === 'en' && !e.title_en?.trim() ? 'de' : undefined}>
                          {e.cancelled ? (
                            <s>{e.time && d.date === e.from && <span class="num">{e.time} </span>}{titleOf(e, lang)}</s>
                          ) : (
                            <>
                              {e.time && d.date === e.from && <span class="num">{e.time} </span>}
                              {e.link ? <a href={e.link} rel="noopener">{titleOf(e, lang)}</a> : titleOf(e, lang)}
                            </>
                          )}
                        </p>
                      </li>
                    ))}
                    {d.closures.map((c) => (
                      <li class="closure" data-groups={closureGroups(c)}>
                        <strong>{headline({ ...c, from: d.date, to: d.date }, lang).replace(/ am .*| on .*/, '')}</strong>: {textOf(c, lang)}
                      </li>
                    ))}
                    {summaries(d).filter((s) => !s.mixed).map((s) => (
                      <li class:list={['training', 'sum', { off: s.off }]} data-disc={s.disc}>
                        <span class="time num">{s.from}–{s.to}</span>
                        {s.off ? (
                          <span><s>{s.label}</s><span class="visually-hidden">{de ? ' (fällt aus)' : ' (cancelled)'}</span></span>
                        ) : (
                          <span>{s.label}</span>
                        )}
                      </li>
                    ))}
                    {d.training.map((tr) => (
                      <li class:list={['training', 'one', { off: tr.off, always: mixedOf(d).has(tr.slot.discipline) }]} data-group={tr.slot.id} hidden={!mixedOf(d).has(tr.slot.discipline)}>
                        <span class="time num">{tr.slot.from}–{tr.slot.to}</span>
                        {tr.off ? (
                          <span><s>{groupName(bySlot.get(tr.slot.id)!)}</s><span class="visually-hidden">{de ? ' (fällt aus)' : ' (cancelled)'}</span></span>
                        ) : (
                          <span>{groupName(bySlot.get(tr.slot.id)!)}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ol>
          </section>
        ))}

        {(later.events.length > 0 || later.closures.length > 0) && (
          <section class="week later" aria-labelledby="w-later">
            <h2 id="w-later">{de ? 'Später' : 'Later'}</h2>
            <ul class="later-list">
              {later.events.map((e) => (
                <li class:list={['event', { cancelled: e.cancelled }]}>
                  <p class="date num">{e.cancelled ? <s>{whenOf(e, lang, thisYear)}</s> : whenOf(e, lang, thisYear)}</p>
                  <div>
                    <p class="meta">
                      {e.cancelled && <strong>{de ? 'Abgesagt' : 'Cancelled'}</strong>}
                      {e.cancelled && (e.kind || e.place) && ', '}
                      {[kindOf(e, lang), e.place].filter(Boolean).join(', ')}
                    </p>
                    <p class="ev-title">{e.cancelled ? <s>{titleOf(e, lang)}</s> : titleOf(e, lang)}</p>
                  </div>
                </li>
              ))}
              {later.closures.map((c) => (
                <li class="closure" data-groups={closureGroups(c)}>
                  <strong>{headline(c, lang)}</strong>: {textOf(c, lang)}
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="empty" hidden>{de ? 'Für diese Gruppe steht in den nächsten Wochen nichts an.' : 'Nothing coming up for this group in the next weeks.'}</p>
      </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var agenda = document.getElementById('agenda');
    var select = document.getElementById('cal-group');
    if (!agenda || !select) return;
    var today = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });
    // Days already over since the last build go; today gets its label.
    agenda.querySelectorAll('.day').forEach(function (d) {
      if (d.dataset.date < today) d.remove();
      else if (d.dataset.date === today) { d.classList.add('is-today'); d.querySelector('.today').hidden = false; }
    });
    var sub = document.getElementById('cal-sub');
    var subLinks = sub ? [].slice.call(sub.querySelectorAll('a[data-cal]')) : [];
    subLinks.forEach(function (a) { a.dataset.all = a.href; });

    function apply(id) {
      var opt = select.querySelector('option[value="' + id + '"]');
      var disc = id && opt ? opt.dataset.disc : null;
      if (id && !opt) id = '';
      // All groups: the per-discipline lines (plus single groups where a discipline is only partly cancelled);
      // one group: its own lines.
      agenda.querySelectorAll('.training.sum').forEach(function (li) { li.hidden = !!id; });
      agenda.querySelectorAll('.training.one').forEach(function (li) {
        li.hidden = id ? li.dataset.group !== id : !li.classList.contains('always');
      });
      agenda.querySelectorAll('.closure').forEach(function (li) {
        var g = li.dataset.groups;
        li.hidden = !!disc && g !== 'alle' && g !== disc;
      });
      // A closure line stays only when the group's own training is cancelled that day.
      agenda.querySelectorAll('.day').forEach(function (d) {
        if (id) d.querySelectorAll('.closure').forEach(function (c) { if (!d.querySelector('.training.off[data-group="' + id + '"]')) c.hidden = true; });
        d.hidden = !d.querySelector('.items > li:not([hidden])');
      });
      var any = false;
      agenda.querySelectorAll('.week').forEach(function (w) {
        var visible = !!w.querySelector('.day:not([hidden]), .later-list > li:not([hidden])');
        w.hidden = !visible;
        any = any || visible;
      });
      agenda.querySelector('.empty').hidden = any;
      if (sub) {
        subLinks.forEach(function (a) { a.href = id ? a.dataset.all.replace('training.ics', id + '.ics') : a.dataset.all; });
        sub.querySelector('.sub-label').textContent = id ? sub.dataset.labelOne : sub.dataset.labelAll;
      }
    }

    var param = new URLSearchParams(location.search).get('group') || '';
    select.value = select.querySelector('option[value="' + param + '"]') ? param : '';
    apply(select.value);
    select.addEventListener('change', function () {
      apply(select.value);
      var url = new URL(location.href);
      if (select.value) url.searchParams.set('group', select.value);
      else url.searchParams.delete('group');
      history.replaceState(null, '', url);
    });
  })();
</script>

<style>
  .cal-page { padding-block: var(--space-page-top) var(--space-section); }
  .lead { margin-top: 12px; font-size: var(--fs-lead); max-width: 52ch; }

  /* Phones: filter and subscribe links above the list. Wide screens: next to it, staying in view while scrolling. */
  .layout { margin-top: 28px; display: grid; gap: 28px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1100px) {
    .layout { grid-template-columns: minmax(0, 52rem) minmax(16rem, 20rem); gap: 56px; align-items: start; }
    .tools { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--menu-top, 72px) + 24px); }
    #agenda { grid-column: 1; grid-row: 1; }
  }
  .tools { display: grid; gap: 24px; align-content: start; }
  .pick { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  @media (min-width: 1100px) { .pick { display: grid; gap: 6px; } }
  .pick label { font-weight: 700; }
  select {
    font: inherit; color: var(--fg); background: var(--bg); border: 2px solid var(--fg); border-radius: 4px;
    padding: 8px 12px; max-width: 100%;
  }
  select:focus-visible { outline: 3px solid var(--gelb); outline-offset: 1px; }
  .subscribe { border-top: 2px solid var(--fg); padding-top: 14px; }
  .subscribe h2 { font-size: var(--fs-item); line-height: 1.2; }
  .sub-label { margin-top: 4px; color: var(--stein); }
  .sub-links { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .sub-links a { font-weight: 700; text-underline-offset: 4px; }
  .howto { display: inline-block; margin-top: 8px; font-size: var(--fs-meta); color: var(--stein); text-underline-offset: 3px; }
  @media (min-width: 1100px) { .sub-links { display: grid; gap: 6px; } }
  .week { border-top: 2px solid var(--fg); padding-top: 14px; }
  .week + .week { margin-top: 34px; }
  .week[hidden], .day[hidden], .items > li[hidden], .later-list > li[hidden] { display: none; }
  .week h2 { font-size: var(--fs-sub); line-height: 1.15; }
  ol, ul { list-style: none; margin: 0; padding: 0; }
  .day, .later-list > li { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 2px 24px; padding-block: 12px; border-bottom: 1px solid var(--linie); align-items: baseline; }
  .later-list > li.closure { display: block; }
  .date { font-weight: 700; }
  .today[hidden] { display: none; }
  .today { display: inline-block; margin-left: 8px; padding: 0 6px; border-radius: 3px; background: var(--gelb); color: #000; font-size: var(--fs-meta); }
  .items { display: grid; gap: 6px; }
  .training { display: flex; gap: 14px; }
  /* The time is what people look for: full colour; the name next to it at normal weight. */
  .time { min-width: 6.5rem; font-variant-numeric: tabular-nums; font-weight: 600; }
  .training.off, .training.off .time { color: var(--stein); }
  s { text-decoration-thickness: 2px; }
  /* Closures: the one thing that changes plans, so it reads first after the dates; yellow like the banner. */
  .closure { padding-left: 12px; border-left: 4px solid var(--gelb-ink); }
  .closure strong { font-weight: 800; }
  .event + .training, .event + .closure, .closure + .training { margin-top: 4px; }
  .meta { font-size: var(--fs-meta); font-weight: 600; color: var(--stein); }
  .meta:empty { display: none; }
  .meta strong { color: var(--fg); font-weight: 800; }
  .ev-title { font-size: var(--fs-item); font-weight: 700; line-height: 1.2; }
  .ev-title a { text-underline-offset: 4px; }
  .event.cancelled .ev-title, .event.cancelled .date { color: var(--stein); }
  .empty { margin-top: 20px; color: var(--stein); }
  @media (max-width: 640px) {
    .day, .later-list > li { grid-template-columns: minmax(0, 1fr); }
    .time { min-width: 5.8rem; }
  }
</style>
