---
/** Kuk Sool Won / Tai Chi page (German and English routes). Times from schedule.json, gallery from the German entry. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HangulSign from './HangulSign.astro';
import VideoEmbeds from './VideoEmbeds.astro';
import NewsLedger from './NewsLedger.astro';
import FaqList from './FaqList.astro';
import { getPosts } from '../lib/posts';
import { getFaq } from '../lib/faq';
import { getSchedule, dayList, ageLabel } from '../lib/schedule';
import { resolveImage, capWidth } from '../lib/images';
import { site } from '../lib/site';
import { disciplineLd, breadcrumbLd } from '../lib/seo';
import { useTranslations, localePath } from '../i18n/ui';
import type { Discipline } from '../lib/disciplines';

interface Props { page: Discipline }
const { page } = Astro.props;
const { lang, entry } = page;
const t = useTranslations(lang);
// Text: the shown language's, else the German one (an English version may have only a title so far).
const bodyEntry = page.textEntry.body?.trim() ? page.textEntry : entry;
const { Content } = await render(bodyEntry);
const slots = await getSchedule(page.slug);
const isKsw = page.slug === 'kuksoolwon';
const textLang = page.textLang !== lang ? page.textLang : undefined;
const bodyLang = bodyEntry === entry && lang !== 'de' ? 'de' : undefined;
// Title image (CMS "Titelbild", also the link preview): right half of the title band on wide screens, below the
// title on phones. First image on the page, so it loads at once.
const titleImage = entry.data.image ? resolveImage(entry.filePath, entry.data.image) : undefined;
// schema.org only on the page in its own language (an untranslated English URL shows German text and is noindex).
const ownPath = page.alternate[lang];
const jsonLd = ownPath
  ? [
      disciplineLd({ slug: page.slug, lang, title: page.title, description: page.description, path: ownPath }),
      breadcrumbLd([{ name: t('nav.home'), path: localePath('/', lang) }, { name: page.title, path: ownPath }]),
    ]
  : undefined;
// Newest reports: all posts so far are about Kuk Sool Won (tournaments, gradings), so only that page lists them.
const latest = isKsw ? (await getPosts(lang)).slice(0, 3) : [];
// Questions marked for this page in the CMS (FAQ › "Auch zeigen auf"), in the FAQ's order.
const faq = (await getFaq(lang)).filter((f) => f.showOn.includes(page.slug));
// The other discipline, in its own tone and type width: jade and wide for Tai Chi, band tone and condensed for Kuk Sool Won.
const youngest = Math.min(...(await getSchedule('kuksoolwon')).map((s) => s.ageMin ?? Infinity));
const de = lang === 'de';
// Photo albums (Flickr): the newest ones show, the rest opens on request, so the reports and questions below stay near.
const ALBUMS_SHOWN = 4;
const albums = entry.data.galleryImages.map((g) => ({ ...g, img: resolveImage(entry.filePath, g.image)!.meta }));
const other = isKsw
  ? {
      slug: 'taichi' as const,
      title: de ? 'Tai Chi, Qi Gong und Atemschulung' : 'Tai Chi, Qi Gong and breathing training',
      line: de ? 'Ruhige Bewegungen und Atemtechnik, in jedem Alter erlernbar.' : 'Calm movements and breathing technique, at any age.',
    }
  : {
      slug: 'kuksoolwon' as const,
      title: 'Kuk Sool Won',
      line: Number.isFinite(youngest)
        ? de ? `Koreanische Kampfkunst für Kinder ab ${youngest} Jahren, Jugendliche und Erwachsene.` : `Korean martial art for children from age ${youngest}, teenagers and adults.`
        : de ? 'Koreanische Kampfkunst für Kinder, Jugendliche und Erwachsene.' : 'Korean martial art for children, teenagers and adults.',
    };
---

<Base title={page.title} searchTitle={page.searchTitle} description={page.description} alternate={page.alternate} image={page.preview ? `/og/discipline-${page.slug}.jpg` : undefined} imageAlt={page.preview?.alt} jsonLd={jsonLd}>
  <section class:list={['band', 'head', isKsw ? 'k' : 't', { 'has-title-image': titleImage }]}>
    <div class="wrap">
      <div class="head-text">
        <HangulSign discipline={isKsw ? 'kuksoolwon' : 'taichi'} />
        <h1 class={isKsw ? 'cond' : 'wide'} lang={textLang}>{page.title}</h1>
      </div>
      {titleImage && (
        <Image class="title-image" src={titleImage.meta} alt={page.preview?.alt ?? ''} width={capWidth(titleImage.meta, 960)} widths={[480, 720, 960].filter((w) => w <= titleImage.meta.width)} sizes="(max-width: 860px) calc(100vw - 32px), 50vw" loading="eager" fetchpriority="high" />
      )}
    </div>
  </section>

  <section class="band body">
    <div class="wrap cols">
      <div class="prose" lang={bodyLang}><Content /></div>
      <VideoEmbeds />
      <aside>
        <h2>{t('times.title')}</h2>
        <table>
          <tbody>
            {slots.map((s) => (
              <tr>
                <th scope="row">{dayList(s.days, lang)}</th>
                <td class="num">{s.from}–{s.to}</td>
                <td>{ageLabel(s, lang) ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
        {/* "Is training on this week?": the calendar page with closures and dates (only when it is switched on). */}
        {site.calendarPage && (
          <p class="cal-link"><a href={localePath('/dates/', lang)}>{lang === 'de' ? 'Ausfälle und Termine im Kalender' : 'Closures and dates in the calendar'}</a></p>
        )}
        <p class="hall">{site.hall.street}, {site.hall.note}<br />{site.hall.city}</p>
        <a class="btn" href={localePath('/#contact', lang)}>{t('cta.trial')}</a>
      </aside>
    </div>
  </section>

  {albums.length > 0 && (
    <section class="band gallery">
      <div class="wrap">
        <div class="sec-h"><h2>{t('gallery.title')}</h2></div>
        <ul>
          {albums.map((g, i) => (
            <li class:list={{ extra: i >= ALBUMS_SHOWN }}>
              <a href={g.link} rel="noopener">
                <Image src={g.img} alt="" width={capWidth(g.img, 600)} quality={75} widths={[300, 600]} sizes="(max-width: 600px) 100vw, 300px" loading="lazy" />
                <span lang={lang !== 'de' ? 'de' : undefined}>{g.link_text}</span>
              </a>
            </li>
          ))}
        </ul>
        {/* Opens the rest of the albums (CSS :has below); an empty <details> so it works without JavaScript. */}
        {albums.length > ALBUMS_SHOWN && (
          <details>
            <summary>
              <span class="closed">{de ? `Alle ${albums.length} Alben zeigen` : `Show all ${albums.length} albums`}</span>
              <span class="open">{de ? 'Weniger Alben zeigen' : 'Show fewer albums'}</span>
            </summary>
          </details>
        )}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="band more">
      <div class="wrap">
        <div class="sec-h"><h2>{t('news.title')}</h2><a href={localePath('/articles/', lang)}>{t('news.all')}</a></div>
        <NewsLedger posts={latest} lang={lang} level={3} />
      </div>
    </section>
  )}

  {faq.length > 0 && (
    <section class="band more">
      <div class="wrap">
        <div class="sec-h plain"><h2>{t('faq.title')}</h2><a href={localePath('/faq/', lang)}>{t('faq.all')}</a></div>
        <FaqList faq={faq} lang={lang} />
      </div>
    </section>
  )}

  <section class="band also">
    <div class="wrap"><p>
      {de ? 'Auch bei uns:' : 'Also with us:'}{' '}
      <a class={other.slug === 'taichi' ? 'wide' : 'cond'} href={localePath(`/category/${other.slug}/`, lang)}>{other.title}</a>.{' '}
      {other.line}
    </p></div>
  </section>
</Base>

<style>
  .head { padding-block: var(--space-compact); }
  /* Title image: wide screens text left, photo right (the band had an empty right half); phones photo below. */
  .head.has-title-image .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 24px 48px; align-items: center; }
  /* The photo in its own aspect ratio, never cropped: the Kuk Sool Won demo uses its full height, the Tai Chi photo
     is a wide shot; a fixed format cut one of them. */
  .head :global(.title-image) { display: block; width: 100%; height: auto; border-radius: 4px; }
  @media (max-width: 860px) {
    .head.has-title-image .wrap { grid-template-columns: minmax(0, 1fr); }
  }
  .head.k { background: var(--panel); color: var(--panel-fg); }
  .head.t { background: var(--tc-bg); color: var(--tc-fg); }
  .t h1 { margin-top: 10px; }
  .k h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.9; font-weight: 900; margin-top: 10px; }
  .t h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 300; }
  .body { padding-block: var(--space-page-top) var(--space-section); }
  /* Long running text (the old site's wording): a step larger with more line spacing, the first paragraph as the lead. */
  .body .prose { font-size: var(--fs-body-lg); line-height: 1.65; max-width: 64ch; }
  .body .prose > :global(p:first-child) { font-size: var(--fs-lead); line-height: 1.5; font-weight: 500; }
  .cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: start; }
  aside { background: var(--card); border: 2px solid var(--fg); border-radius: 4px; padding: 20px; box-shadow: 12px 12px 0 var(--gelb); margin-right: 12px; }
  aside h2 { font-size: var(--fs-sub); margin-bottom: 10px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 8px 8px 0; border-bottom: 1px solid var(--linie); vertical-align: top; }
  th { font-weight: 600; }
  .hall { margin-top: 16px; color: var(--stein); }
  aside .btn { margin-top: 16px; }
  .cal-link { margin-top: 12px; font-weight: 700; }
  .cal-link a { text-decoration: underline; text-underline-offset: 4px; }
  .more { padding-block: 0 var(--space-section); }
  /* The accordion draws its own top rule: the heading above it needs none. */
  .sec-h.plain { border-bottom: 0; padding-bottom: 14px; max-width: 52rem; }
  /* The other discipline: one quiet line at the end of the page, its name in its own type width. */
  .also { padding-block: 0 var(--space-section); }
  .also p { border-top: 1px solid var(--linie); padding-top: 22px; color: var(--stein); }
  .also a { color: var(--fg); font-size: var(--fs-item); text-underline-offset: 5px; }
  .also a.cond { font-weight: 900; }
  .also a.wide { font-weight: 300; }
  .gallery { padding-block: 0 var(--space-section); }
  /* Four albums in a row (two on phones): the first four fill exactly one row, or two rows of two. */
  .gallery ul { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .gallery a { text-decoration: none; display: grid; gap: 6px; font-weight: 600; transition: transform 300ms ease-in; }
  /* Same subtle zoom as the old site's .gal-item:hover */
  .gallery a:hover, .gallery a:focus-visible { transform: scale(1.05); }
  .gallery :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; display: block; }
  .gallery details { margin-top: 20px; }
  .gallery summary { cursor: pointer; list-style: none; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; width: fit-content; }
  .gallery summary::-webkit-details-marker { display: none; }
  .gallery details:not([open]) .open, .gallery details[open] .closed { display: none; }
  /* Albums after the first few stay hidden until the line below the grid is opened. Browsers without :has show all. */
  .gallery li.extra { display: none; }
  .gallery:has(details[open]) li.extra { display: list-item; }
  @supports not selector(:has(*)) { .gallery li.extra { display: list-item; } .gallery details { display: none; } }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } .gallery ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; } }
</style>
