---
/**
 * Desktop: links in the header row. Mobile (<= 860px): "Menü" button opens the same list as a popover panel.
 * The Popover API handles open/close, Esc, tap outside and focus without JS; the small script only closes
 * the panel after a link tap (same-page anchors) and when the window grows to desktop width.
 */
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternate?: { de?: string; en?: string };
}
const { lang, alternate } = Astro.props;
const t = useTranslations(lang);
// Language switch "Deutsch / English": the current language is marked, the other links to the same page in that
// language. Untranslated English pages exist too (German content, English navigation), so you stay on the page.
const reqPath = Astro.originPathname || Astro.url.pathname; // see Base.astro
const dePath = reqPath.replace(/^\/en(?=\/|$)/, '') || '/';
const languages = (['de', 'en'] as const).map((code) => ({
  code,
  name: code === 'de' ? 'Deutsch' : 'English',
  current: code === lang,
  href: alternate?.[code] ?? (code === 'de' ? dePath : `/en${dePath}`),
}));
const path = reqPath;
const links = [
  { href: '/category/kuksoolwon/', label: t('nav.ksw') },
  { href: '/category/taichi/', label: t('nav.taichi') },
  { href: '/articles/', label: t('nav.news') },
  { href: '/other/contact/', label: t('nav.contact') },
].map((l) => ({ ...l, href: localePath(l.href, lang) }));
---

<header class="top band">
  <div class="wrap">
    <a class="brand" href={localePath('/', lang)}>
      <img src="/images/Logo.svg" alt="" width="30" height="40" />
      <span>Kampfkunst Academy<small>Peter Griepentrog</small></span>
    </a>
    <nav aria-label={t('nav.main')}>
      <button class="burger" type="button" popovertarget="menu" aria-controls="menu">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
        {t('nav.menu')}
      </button>
      <div id="menu" popover>
        <ul>
          {
            links.map((l) => (
              <li>
                <a class="link" href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
              </li>
            ))
          }
          <li class="langs" role="group" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
            {languages.map((l, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">/</span>}
                {l.current ? (
                  <span class="lang current" lang={l.code} aria-current="true">{l.name}</span>
                ) : (
                  <a class="lang" href={l.href} hreflang={l.code} lang={l.code}>{l.name}</a>
                )}
              </>
            ))}
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  const menu = document.getElementById('menu') as HTMLElement & { hidePopover?: () => void };
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  if (menu && burger && 'hidePopover' in menu) {
    menu.addEventListener('toggle', (e) => burger.setAttribute('aria-expanded', String((e as ToggleEvent).newState === 'open')));
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a') && menu.matches(':popover-open')) menu.hidePopover!();
    });
    matchMedia('(min-width: 861px)').addEventListener('change', (mq) => {
      if (mq.matches && menu.matches(':popover-open')) menu.hidePopover!();
    });
  }
</script>

<style>
  .top {
    background: var(--bg);
    color: var(--fg);
    border-bottom: 6px solid var(--gelb);
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
  }
  .wrap { display: flex; align-items: center; gap: 24px; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 800; line-height: 1.05; }
  .brand img { width: 30px; height: 40px; filter: var(--logo-filter); }
  .brand small { display: block; font-weight: 500; font-size: 0.8rem; }
  nav { margin-left: auto; font-weight: 600; font-size: 0.95rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { text-decoration: none; }
  .link:hover, .link[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }

  /* Language switch: current language bold with a yellow underline, the other one quieter. */
  .langs { display: flex; align-items: baseline; gap: 8px; font-size: 0.9rem; }
  .lang { color: var(--stein); font-weight: 500; }
  a.lang:hover { color: var(--fg); text-decoration: underline; text-underline-offset: 4px; }
  .lang.current { color: var(--fg); font-weight: 800; text-decoration: underline; text-decoration-color: var(--gelb); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .sep { color: var(--stein); }

  /* Desktop: the popover element is shown inline as a normal row (author display beats the UA "hidden" rule). */
  @media (min-width: 861px) {
    .burger { display: none; }
    #menu { display: block; position: static; inset: auto; margin: 0; padding: 0; border: 0; background: none; color: inherit; overflow: visible; }
    ul { display: flex; gap: 22px; align-items: center; }
    .langs { padding-left: 22px; border-left: 1px solid var(--linie); }
  }

  /* Mobile: button + full-width panel under the header. */
  @media (max-width: 860px) {
    .burger {
      display: inline-flex; align-items: center; gap: 10px;
      background: transparent; color: var(--fg); border: 2px solid currentColor; border-radius: 4px;
      padding: 8px 12px; font: 700 0.95rem var(--f); cursor: pointer;
    }
    .bars { display: grid; gap: 4px; width: 18px; }
    .bars i { display: block; height: 2px; background: currentColor; border-radius: 1px; transition: transform 0.2s ease, opacity 0.2s ease; }
    .burger[aria-expanded='true'] .bars i:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .burger[aria-expanded='true'] .bars i:nth-child(2) { opacity: 0; }
    .burger[aria-expanded='true'] .bars i:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    #menu {
      position: fixed; inset: calc(env(safe-area-inset-top, 0px) + 70px) 0 auto 0; margin: 0; width: auto;
      max-height: calc(100dvh - 70px - env(safe-area-inset-top, 0px)); overflow: auto;
      border: 0; border-bottom: 6px solid var(--gelb); background: var(--bg); color: var(--fg);
      padding: 8px var(--gutter-r) 24px var(--gutter-l);
      box-shadow: 0 24px 48px rgb(0 0 0 / 0.35);
    }
    #menu::backdrop { background: rgb(0 0 0 / 0.45); }
    #menu li { border-bottom: 1px solid var(--linie); }
    #menu a { display: block; padding: 16px 0; font-size: 1.6rem; font-weight: 800; font-stretch: 62%; }
    #menu .link[aria-current='page'] { text-decoration: none; box-shadow: inset 6px 0 0 var(--gelb); padding-left: 16px; }
    #menu .langs { border-bottom: 0; padding-top: 18px; font-size: 1.1rem; }
    #menu .langs a { display: inline; padding: 0; font-size: inherit; font-weight: 600; font-stretch: 100%; }
  }
</style>
