---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Medals from './Medals.astro';
import { localePath } from '../i18n/ui';
import type { Post } from '../lib/posts';
import { articleLd } from '../lib/seo';
import { capWidth } from '../lib/images';

interface Props { post: Post }
const { post } = Astro.props;
const { data } = post.entry;
const { Content } = await render(post.entry);
const fmt = new Intl.DateTimeFormat(post.lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// News keep the whole report in "description" (old CMS form had no body field).
const paragraphs = post.paragraphs;
---

<Base
  title={data.title}
  description={paragraphs[0]?.slice(0, 160)}
  image={post.image ? `/og/${post.slug}.jpg` : undefined}
  imageAlt={data.image_text && data.image_text !== 'placeholder' ? data.image_text : data.title}
  ogType="article"
  articleDate={post.date.toISOString().slice(0, 10)}
  jsonLd={articleLd(post)}
>
  <article class="band">
    <div class="wrap">
      <header>
        <p class="meta">
          <time datetime={post.date.toISOString().slice(0, 10)}>{fmt.format(post.date)}</time>
          {data.kind && <span>{data.kind}</span>}
          {data.place && <span>{data.place}</span>}
        </p>
        <h1 class="cond">{data.title}</h1>
        <Medals medals={data.medals} />
      </header>
      <div class="cols">
        <div class="prose">
          {paragraphs.map((p) => <p class="desc">{p}</p>)}
          <Content />
        </div>
        {post.image && (
          <figure>
            <Image src={post.image.meta} alt={data.image_text || ''} width={capWidth(post.image.meta, 1600)} quality={75} widths={[480, 800, 1200, 1600]} sizes="(max-width: 800px) 100vw, 40vw" />
            {data.image_text && data.image_text !== 'placeholder' && <figcaption>{data.image_text}</figcaption>}
          </figure>
        )}
      </div>
      <p class="back"><a href={localePath('/articles/', post.lang)}>Alle Beiträge</a></p>
    </div>
  </article>
</Base>

<style>
  article { padding-block: 40px 72px; }
  header { border-bottom: 6px solid var(--gelb); padding-bottom: 16px; display: grid; gap: 10px; }
  .meta { color: var(--stein); display: flex; gap: 16px; flex-wrap: wrap; font-weight: 600; }
  h1 { font-size: clamp(2.2rem, 6vw, 4.2rem); line-height: 0.95; font-weight: 900; }
  .cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; margin-top: 32px; align-items: start; }
  /* Short text keeps its line breaks (old CMS texts); the Markdown report below is formatted by Astro. */
  .desc { white-space: pre-line; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; border-radius: 4px; display: block; }
  figcaption { font-size: 0.85rem; color: var(--stein); margin-top: 8px; }
  .back { margin-top: 48px; font-weight: 700; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
