---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Medals from './Medals.astro';
import { localePath } from '../i18n/ui';
import type { Post } from '../lib/posts';
import { articleLd } from '../lib/seo';
import { capWidth } from '../lib/images';

interface Props { post: Post }
const { post } = Astro.props;
const { data } = post.entry;
// Report: the shown language's, else the German one (an English translation may leave the report out).
const bodyEntry = post.textEntry.body?.trim() ? post.textEntry : post.entry;
const bodyLang = bodyEntry === post.entry && post.lang !== 'de' ? 'de' : undefined;
const { Content } = await render(bodyEntry);
const fmt = new Intl.DateTimeFormat(post.lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// News keep the whole report in "description" (old CMS form had no body field).
const paragraphs = post.paragraphs;
---

<Base
  title={post.title}
  alternate={post.alternate}
  description={paragraphs[0]?.slice(0, 160)}
  image={post.image ? `/og/${post.slug}.jpg` : undefined}
  imageAlt={post.imageText && post.imageText !== 'placeholder' ? post.imageText : post.title}
  ogType="article"
  articleDate={post.date.toISOString().slice(0, 10)}
  jsonLd={articleLd(post)}
>
  <article class="band">
    <div class="wrap">
      <!-- Most visitors arrive here from a shared link: the way to the other posts comes first, not only at the end. -->
      <p class="up"><a href={localePath('/articles/', post.lang)}><svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{post.lang === 'de' ? 'Alle Beiträge' : 'All posts'}</a></p>
      <header>
        <p class="meta">
          <time datetime={post.date.toISOString().slice(0, 10)}>{fmt.format(post.date)}</time>
          {data.kind && <span>{data.kind}</span>}
          {data.place && <span>{data.place}</span>}
        </p>
        <h1 class="cond">{post.title}</h1>
        <Medals medals={data.medals} />
      </header>
      <div class="cols">
        <div class="prose">
          {paragraphs.map((p) => <p class="desc" lang={post.descriptionLang !== post.lang ? post.descriptionLang : undefined}>{p}</p>)}
          <div lang={bodyLang}><Content /></div>
        </div>
        {post.image && (
          <figure>
            <Image src={post.image.meta} alt={post.imageText || ''} width={capWidth(post.image.meta, 1600)} quality={75} widths={[480, 800, 1200, 1600]} sizes="(max-width: 800px) 100vw, 40vw" />
            {post.imageText && post.imageText !== 'placeholder' && <figcaption>{post.imageText}</figcaption>}
          </figure>
        )}
      </div>
      <p class="back"><a href={localePath('/articles/', post.lang)}><svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{post.lang === 'de' ? 'Alle Beiträge' : 'All posts'}</a></p>
    </div>
  </article>
</Base>

<style>
  article { padding-block: 40px 72px; }
  header { border-bottom: 2px solid var(--fg); padding-bottom: 16px; display: grid; gap: 10px; }
  .meta { color: var(--stein); display: flex; gap: 16px; flex-wrap: wrap; font-weight: 600; }
  h1 { font-size: clamp(2.2rem, 6vw, 4.2rem); line-height: 0.95; font-weight: 900; }
  .cols { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; margin-top: 32px; align-items: start; }
  /* Short text keeps its line breaks (old CMS texts); the Markdown report below is formatted by Astro. */
  .desc { white-space: pre-line; }
  figure { margin: 0; }
  figure :global(img) { width: 100%; height: auto; border-radius: 4px; display: block; }
  figcaption { font-size: 0.85rem; color: var(--stein); margin-top: 8px; }
  .back { margin-top: 48px; font-weight: 700; }
  .up { margin-bottom: 18px; font-weight: 700; font-size: 0.95rem; }
  .up a, .back a { display: inline-flex; align-items: center; gap: 6px; text-underline-offset: 4px; }
  /* Small back chevron: answers "where does this go" at a glance; nudges left on hover. */
  .arrow { flex: none; transition: transform 0.15s ease; }
  .up a:hover .arrow, .back a:hover .arrow { transform: translateX(-2px); }
  @media (prefers-reduced-motion: reduce) { .arrow { transition: none; } }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr; } }
</style>
