---
/**
 * One quiet line at the end of a post: from the report to the training. Most readers arrive from a shared link and
 * have never seen the Kuk Sool Won page; the link also tells search engines which page is about the training.
 * All posts so far are about Kuk Sool Won, so the link always goes there.
 */
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
---

<aside class="cta" aria-label={de ? 'Selbst trainieren' : 'Train with us'}>
  <p>
    <strong>{de ? 'Neugierig geworden?' : 'Curious?'}</strong>{' '}
    {de ? 'Probier es selbst aus.' : 'Try it yourself.'}{' '}
    <a href={localePath('/category/kuksoolwon/', lang)}>{de ? 'Kuk Sool Won bei uns: Gruppen und Trainingszeiten' : 'Kuk Sool Won with us: groups and training times'}<svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
  </p>
</aside>

<style>
  .cta { margin-top: 40px; padding-top: 20px; border-top: 2px solid var(--gelb); max-width: 68ch; }
  .cta p { font-size: var(--fs-body-lg); line-height: 1.5; }
  .cta a { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-underline-offset: 4px; }
  .arrow { flex: none; transition: transform 0.15s ease; }
  .cta a:hover .arrow { transform: translateX(2px); }
  @media (prefers-reduced-motion: reduce) { .arrow { transition: none; } }
</style>
