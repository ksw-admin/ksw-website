---
/**
 * One quiet line at the end of a post: from the report to the training. Most readers arrive from a shared link and
 * have never seen the Kuk Sool Won page; the link also tells search engines which page is about the training.
 * All posts so far are about Kuk Sool Won, so the link always goes there. Switch: site.json › postCta (CMS:
 * Einstellungen › Kontakt und Allgemeines).
 */
import NextLine from './NextLine.astro';
import { localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const de = lang === 'de';
---

<NextLine
  label={de ? 'Selbst trainieren' : 'Train with us'}
  lead={de ? 'Neugierig geworden?' : 'Curious?'}
  text={de ? 'Komm zum Probetraining.' : 'Come for a trial lesson.'}
  href={localePath('/category/kuksoolwon/', lang)}
  link={de ? 'Kuk Sool Won bei uns: Gruppen und Trainingszeiten' : 'Kuk Sool Won with us: groups and training times'}
/>
