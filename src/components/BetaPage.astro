---
/**
 * Beta page: Lean opt-in / opt-out switcher for Netlify Split Testing.
 * Adheres strictly to design-system/README.md:
 * - Archivo condensed heading on the yellow rule (.sec-h)
 * - Yellow mat box shadow (8px 8px 0 var(--gelb)) on the switcher panel
 * - No emoji, no pills, no generic SaaS card grids
 * - Left-aligned, concise, plain language
 */
import Base from '../layouts/Base.astro';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const isDe = lang === 'de';
---

<Base
  title={t('beta.page.title')}
  description={t('beta.page.lead')}
  alternate={{ de: '/beta/', en: '/en/beta/' }}
  noindex
>
  <section class="band beta-section">
    <div class="wrap">
      <div class="sec-h">
        <h1>{t('beta.page.title')}</h1>
      </div>

      <p class="intro">{t('beta.page.lead')}</p>

      <!-- Switcher Panel with Signature Yellow Mat Shadow -->
      <div class="switcher-panel">
        <div class="status-block">
          <p class="status-label">{isDe ? 'Aktive Version:' : 'Active version:'}</p>
          <p class="status-value">
            <span id="status-dot" class="dot"></span>
            <strong id="status-text">{t('beta.page.active')}</strong>
          </p>
          <p class="status-cookie num">
            Netlify Split-Testing: <code id="cookie-label">nf_ab=astro-redesign</code>
          </p>
        </div>

        <div class="action-block">
          <button type="button" id="btn-leave-beta" class="btn">
            {t('beta.page.btn.leave')}
          </button>
          <button type="button" id="btn-join-beta" class="btn" hidden>
            {t('beta.page.btn.join')}
          </button>
          <a href={localePath('/', lang)} class="home-link">
            {isDe ? 'Zur Startseite' : 'To home page'}
          </a>
        </div>
      </div>

      <!-- Share Box -->
      <div class="share-box">
        <h2>{t('beta.page.share')}</h2>
        <p class="share-hint">
          {
            isDe
              ? 'Dieser Link aktiviert die Vorschau auf einem anderen Gerät oder Browser:'
              : 'This link activates the preview on another device or browser:'
          }
        </p>
        <div class="share-row">
          <input
            type="text"
            id="share-link-input"
            class="num"
            readonly
            value="https://www.kuk-sool-won-griepentrog.de/?beta=1"
            aria-label={t('beta.page.share')}
          />
          <button type="button" id="btn-copy-link" class="btn">
            {isDe ? 'Kopieren' : 'Copy'}
          </button>
        </div>
        <p id="copy-confirmation" class="copy-success" aria-live="polite" hidden>
          {t('beta.page.share.copied')}
        </p>
      </div>

      <!-- Feedback Note -->
      <div class="feedback-box">
        <h2>{t('beta.page.feedback.title')}</h2>
        <p>{t('beta.page.feedback.text')}</p>
        <p class="feedback-links">
          <a href={localePath('/faq/#frage', lang)} class="link">
            {isDe ? 'Frageformular' : 'Question form'}
          </a>
          <span class="sep">·</span>
          <a href={localePath('/other/contact/', lang)} class="link">
            {isDe ? 'Kontakt' : 'Contact'}
          </a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var hasBetaCookie = /(?:^|;\s*)nf_ab=astro-redesign/.test(document.cookie);
    var hasMainCookie = /(?:^|;\s*)nf_ab=main/.test(document.cookie);

    var statusDot = document.getElementById('status-dot');
    var statusText = document.getElementById('status-text');
    var cookieLabel = document.getElementById('cookie-label');
    var btnJoin = document.getElementById('btn-join-beta');
    var btnLeave = document.getElementById('btn-leave-beta');

    function updateUI() {
      if (hasMainCookie && !hasBetaCookie) {
        if (statusDot) statusDot.classList.add('inactive');
        if (statusText) statusText.textContent = isDe ? 'Bisherige Website aktiv' : 'Classic site active';
        if (cookieLabel) cookieLabel.textContent = 'nf_ab=main';
        if (btnJoin) btnJoin.hidden = false;
        if (btnLeave) btnLeave.hidden = true;
      } else {
        if (statusDot) statusDot.classList.remove('inactive');
        if (statusText) statusText.textContent = isDe ? 'Vorschau aktiv (Neues Design)' : 'Preview active (New design)';
        if (cookieLabel) cookieLabel.textContent = 'nf_ab=astro-redesign';
        if (btnJoin) btnJoin.hidden = true;
        if (btnLeave) btnLeave.hidden = false;
      }
    }

    updateUI();

    if (btnLeave) {
      btnLeave.addEventListener('click', function () {
        var secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = 'nf_ab=main; path=/; max-age=31536000; SameSite=Lax' + secure;
        try {
          sessionStorage.removeItem('ksw-beta-dismissed');
        } catch (e) {}
        window.location.replace('/');
      });
    }

    if (btnJoin) {
      btnJoin.addEventListener('click', function () {
        var secure = location.protocol === 'https:' ? '; Secure' : '';
        document.cookie = 'nf_ab=astro-redesign; path=/; max-age=31536000; SameSite=Lax' + secure;
        window.location.replace('/');
      });
    }

    // Share link
    var btnCopy = document.getElementById('btn-copy-link');
    var shareInput = document.getElementById('share-link-input');
    var copyConf = document.getElementById('copy-confirmation');
    if (shareInput && location.origin) {
      shareInput.value = location.origin + '/?beta=1';
    }

    if (btnCopy && shareInput) {
      btnCopy.addEventListener('click', function () {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(shareInput.value).then(function () {
            if (copyConf) {
              copyConf.hidden = false;
              setTimeout(function () {
                copyConf.hidden = true;
              }, 3000);
            }
          });
        }
      });
    }
  })();
</script>

<style>
  .beta-section {
    padding-block: 48px 96px;
  }
  .intro {
    font-size: 1.15rem;
    color: var(--stein);
    margin-top: 16px;
    max-width: 65ch;
  }
  /* The switcher panel: Nearly square (radius-md: 4px), bordered, with the site's solid yellow mat */
  .switcher-panel {
    background: var(--card);
    border: 2px solid var(--fg);
    border-radius: 4px;
    box-shadow: 8px 8px 0 var(--gelb);
    padding: 24px;
    margin-top: 36px;
    max-width: 640px;
    display: grid;
    gap: 20px;
  }
  .status-block {
    display: grid;
    gap: 4px;
  }
  .status-label {
    font-size: 0.85rem;
    color: var(--stein);
    margin: 0;
  }
  .status-value {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.25rem;
    margin: 0;
  }
  .dot {
    width: 10px;
    height: 10px;
    background: var(--jade);
    display: inline-block;
  }
  .dot.inactive {
    background: var(--stein);
  }
  .status-cookie {
    font-size: 0.85rem;
    color: var(--stein);
    margin: 4px 0 0;
  }
  .status-cookie code {
    background: var(--bg);
    border: 1px solid var(--linie);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--fg);
  }
  .action-block {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--linie);
  }
  .home-link {
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .home-link:hover,
  .home-link:focus-visible {
    color: var(--fg);
    text-decoration: underline;
  }

  /* Share and feedback sections: quiet, left-aligned, no cards */
  .share-box,
  .feedback-box {
    margin-top: 48px;
    max-width: 640px;
  }
  h2 {
    font-size: 1.35rem;
    font-weight: 800;
    font-stretch: 62%;
    margin-bottom: 8px;
  }
  .share-hint,
  .feedback-box p {
    color: var(--stein);
    margin: 0 0 12px;
  }
  .share-row {
    display: flex;
    gap: 8px;
  }
  .share-row input {
    flex: 1;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--linie);
    border-radius: 4px;
    padding: 10px 14px;
    font: inherit;
    font-size: 0.95rem;
  }
  .share-row input:focus-visible {
    outline: 3px solid var(--jade);
    outline-offset: 1px;
  }
  .copy-success {
    margin: 8px 0 0;
    color: var(--jade);
    font-weight: 700;
    font-size: 0.9rem;
  }
  .feedback-links {
    margin-top: 8px;
  }
  .link {
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .sep {
    color: var(--linie);
    margin-inline: 6px;
  }
</style>
