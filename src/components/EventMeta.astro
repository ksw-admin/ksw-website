---
/**
 * The small line below a date's title: kind and place ("Turnier, Arnsberg"). "Abgesagt" is not here: it stands right
 * before the title (it must not be missed). Renders only the content: the caller wraps it in its own <p class="meta"> and styles that.
 * Used by "Demnächst" (UpcomingEvents) and the calendar page.
 */
import { kindOf, type SiteEvent } from '../lib/events';
import type { Lang } from '../i18n/ui';

interface Props { event: SiteEvent; lang: Lang }
const { event: e, lang } = Astro.props;
const rest = [kindOf(e, lang), e.place].filter(Boolean).join(', ');
---

{rest}

